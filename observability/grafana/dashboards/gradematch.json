{
  "uid": "gradematch",
  "title": "GradeMatch",
  "schemaVersion": 40,
  "version": 1,
  "tags": [
    "gradematch"
  ],
  "timezone": "utc",
  "editable": false,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "environment",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(gradematch_styles_generated_total, environment)",
          "refId": "environment"
        },
        "definition": "label_values(gradematch_styles_generated_total, environment)",
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "current": {}
      },
      {
        "name": "version",
        "label": "Version",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(gradematch_styles_generated_total{environment=~\"$environment\"}, version)",
          "refId": "version"
        },
        "definition": "label_values(gradematch_styles_generated_total{environment=~\"$environment\"}, version)",
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Styles generated / second",
      "description": "No data means no matching traffic in the selected window; run observability/dashboard_smoke.py. Rates need at least two scrapes.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "noValue": "No matching traffic"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(gradematch_styles_generated_total{environment=~\"$environment\",version=~\"$version\"}[$__rate_interval]))",
          "legendFormat": "styles / s",
          "range": true,
          "interval": "5s"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Generate failures / second by reason",
      "description": "No data means no matching traffic in the selected window; run observability/dashboard_smoke.py. Rates need at least two scrapes.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "noValue": "No matching traffic"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason) (rate(gradematch_generate_failures_total{environment=~\"$environment\",version=~\"$version\"}[$__rate_interval]))",
          "legendFormat": "{{reason}}",
          "range": true,
          "interval": "5s"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Looks saved / second",
      "description": "No data means no matching traffic in the selected window; run observability/dashboard_smoke.py. Rates need at least two scrapes.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "noValue": "No matching traffic"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(gradematch_looks_saved_total{environment=~\"$environment\",version=~\"$version\"}[$__rate_interval]))",
          "legendFormat": "looks / s",
          "range": true,
          "interval": "5s"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Users registered / second",
      "description": "No data means no matching traffic in the selected window; run observability/dashboard_smoke.py. Rates need at least two scrapes.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "noValue": "No matching traffic"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(gradematch_users_registered_total{environment=~\"$environment\",version=~\"$version\"}[$__rate_interval]))",
          "legendFormat": "users / s",
          "range": true,
          "interval": "5s"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "LUT render latency p95 (seconds)",
      "description": "No data means no matching traffic in the selected window; run observability/dashboard_smoke.py. Rates need at least two scrapes.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "noValue": "No matching traffic"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(gradematch_lut_render_seconds_bucket{environment=~\"$environment\",version=~\"$version\"}[$__rate_interval])))",
          "legendFormat": "p95 seconds",
          "range": true,
          "interval": "5s"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "HTTP requests / second",
      "description": "No data means no matching traffic in the selected window; run observability/dashboard_smoke.py. Rates need at least two scrapes.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "noValue": "No matching traffic"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(gradematch_http_requests_total{service_name=\"gradematch\",deployment_environment=~\"$environment\",service_version=~\"$version\"}[$__rate_interval]))",
          "legendFormat": "requests / s",
          "range": true,
          "interval": "5s"
        }
      ]
    }
  ]
}
